<Window x:Class="ServiceWatchdog.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Правило" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Имя правила:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6" Padding="4"/>

        <TextBlock Text="Тип:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,6"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6">
            <RadioButton x:Name="ServiceRadioButton" Content="Служба Windows" GroupName="RuleType"
                         Checked="TypeRadioButton_Checked" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="ProcessRadioButton" Content="Процесс (приложение)" GroupName="RuleType"
                         Checked="TypeRadioButton_Checked" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Service fields -->
        <TextBlock x:Name="ServiceNameLabel" Text="Имя службы:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="ServiceNameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6" Padding="4"/>
        <Button x:Name="PickServiceButton" Content="Выбрать…" Grid.Row="2" Grid.Column="2" Margin="6,6,0,6" Padding="10,4" Click="PickServiceButton_Click"/>

        <!-- Process fields -->
        <TextBlock x:Name="ProcessPathLabel" Text="Путь к .exe:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="ProcessPathTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6" Padding="4"/>
        <Button x:Name="BrowseButton" Content="Обзор…" Grid.Row="3" Grid.Column="2" Margin="6,6,0,6" Padding="10,4" Click="BrowseButton_Click"/>

        <TextBlock x:Name="ProcessArgsLabel" Text="Аргументы запуска:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="ProcessArgsTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6" Padding="4"
                 ToolTip="Необязательно. Например: --minimized --config &quot;C:\path\config.ini&quot;"/>

        <TextBlock Text="Интервал проверки (сек):" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="IntervalTextBox" Grid.Row="5" Grid.Column="1" Margin="0,6" Padding="4" Width="100" HorizontalAlignment="Left"/>

        <CheckBox x:Name="EnabledCheckBox" Content="Правило активно" Grid.Row="6" Grid.Column="1" Margin="0,10" IsChecked="True"/>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="90" Padding="6" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="Сохранить" Width="90" Padding="6" Click="SaveButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
